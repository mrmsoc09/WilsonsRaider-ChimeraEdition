# OSINT & BBP Scanner Environment Configuration
# File: .env.osint
# Copy to .env and fill in your actual credentials

# ============================================================================
# BUG BOUNTY PROGRAM (BBP) SOURCES
# ============================================================================

# HackerOne - Personal Access Token (PAT)
# Get from: https://hackerone.com/settings/personal_access_tokens
HACKERONE_PAT=your_hackerone_pat_token_here

# Bugcrowd - OAuth2 Credentials
# Get from: https://bugcrowd.com/account/settings/integrations/api
BUGCROWD_CLIENT_ID=your_bugcrowd_client_id
BUGCROWD_CLIENT_SECRET=your_bugcrowd_client_secret

# Intigriti - Bearer Token
# Get from: https://intigriti.com/research-hub/profile/settings/api-tokens
INTIGRITI_API_TOKEN=your_intigriti_api_token

# ============================================================================
# OSINT API CREDENTIALS (Free Tier Services)
# ============================================================================

# Shodan - IP/Service enumeration
# Get from: https://www.shodan.io/account
SHODAN_API_KEY=your_shodan_api_key

# Censys - Certificate/Service enumeration
# Get from: https://censys.io/register/
CENSYS_UID=your_censys_user_id
CENSYS_SECRET=your_censys_api_secret

# GreyNoise - IP Reputation
# Get from: https://www.greynoise.io/
GREYNOISE_API_KEY=your_greynoise_community_key

# ZoomEye - Threat Intelligence
# Get from: https://www.zoomeye.org/login
ZOOMEYE_API_KEY=your_zoomeye_api_key

# BinaryEdge - Vulnerability/Service enumeration
# Get from: https://app.binaryedge.io/
BINARYEDGE_API_KEY=your_binaryedge_api_key

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================

# PostgreSQL (OSINT findings storage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kaison_osint
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=kaison_osint

# MongoDB (Document storage for complex findings)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kaison_osint

# Redis (Cache and queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here

# ============================================================================
# KAISON AI CONFIGURATION
# ============================================================================

# Instance pool
KAISON_INSTANCES_COUNT=150
KAISON_API_BASE_URL=http://localhost:8000

# Orchestrator settings
OSINT_ORCHESTRATOR_PORT=8500
OSINT_ORCHESTRATOR_HOST=0.0.0.0
OSINT_ORCHESTRATOR_WORKERS=4

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/logs/osint_scanner.log

# Prometheus metrics
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=true

# ============================================================================
# INTEGRATION SERVICES
# ============================================================================

# Wazuh (Security monitoring)
WAZUH_API_URL=http://localhost:55000
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=admin_password

# TheHive (Case management)
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=your_thehive_api_key

# Shuffle (SOAR automation)
SHUFFLE_URL=http://localhost:3001
SHUFFLE_API_KEY=your_shuffle_api_key

# ============================================================================
# SCAN CONFIGURATION
# ============================================================================

# Global scanning settings
SCAN_TIMEOUT_SECONDS=3600
SCAN_RETRY_ATTEMPTS=3
SCAN_RETRY_DELAY=300

# BBOP polling interval (seconds)
BBOP_POLL_INTERVAL=300  # 5 minutes

# OSINT scan scheduling
DOMAIN_INTELLIGENCE_INTERVAL=86400  # 24 hours
IP_NETWORK_SCAN_INTERVAL=43200     # 12 hours
PERSONA_INTELLIGENCE_INTERVAL=172800 # 48 hours
THREAT_CORRELATION_INTERVAL=21600   # 6 hours

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================

# Encryption keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_char_hex_key_here
SECRET_KEY=your_secret_key_for_sessions

# TLS/SSL
TLS_ENABLED=false
TLS_CERT_FILE=/certs/cert.pem
TLS_KEY_FILE=/certs/key.pem

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=alerts@kaison.com

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#osint-alerts

# WebHook for custom integrations
WEBHOOK_URL=http://your-server.com/webhook
WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Docker settings
DOCKER_REGISTRY=your-registry
DOCKER_IMAGE_PREFIX=kaison

# GitHub settings (for repo updates)
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=agent0ai
GITHUB_REPO_NAME=agent-zero

# ============================================================================
# DEBUG & DEVELOPMENT
# ============================================================================

# Enable debug mode
DEBUG=false

# Performance profiling
ENABLE_PROFILING=false
PROFILE_OUTPUT_FILE=/logs/profile.txt

# Database logging
SQLALCHEMY_ECHO=false

# Request/Response logging
HTTP_LOGGING_ENABLED=true

# ============================================================================
# OPTIONAL: ADVANCED FEATURES
# ============================================================================

# Machine learning threat scoring
ML_THREAT_SCORING_ENABLED=false
ML_MODEL_PATH=/models/threat_scorer.pkl

# Custom OSINT tool paths (if not using defaults)
ALPHA_OMEGA_PATH=/kaison-c-c/ALPHA-OMEGA-Project-Sentinel
OSINT_FRAMEWORK_PATH=/kaison-c-c/OSINT-Framework
CHIMERA_PATH=/kaison-c-c/WilsonsRaider-ChimeraEdition

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=1000

# ============================================================================
# NOTES
# ============================================================================
#
# 1. PAT/Bearer Tokens: Use environment variables for all secrets
# 2. Keep this file secure: chmod 600 .env.osint
# 3. Never commit .env file to version control
# 4. Use separate .env files for dev/staging/prod
# 5. Rotate API keys every 90 days
# 6. Monitor API rate limits in logs
#
